# --- Mongo ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rag_api_tester?retryWrites=true&w=majority

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
GENERATION_MODEL=gemini-3.6-flash

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# --- Server ---
PORT=5000
