
# MongoDB Atlas: same cluster, two databases (path segment after the slash)
MONGODB_URI=mongodb+srv://<MONGO_USERNAME>:<MONGO_PASSWORD>@<CLUSTER>.mongodb.net/rag_main?appName=RAG
# server.js throws on startup if this is missing
REPORTS_DB_URI=mongodb+srv://<MONGO_USERNAME>:<MONGO_PASSWORD>@<CLUSTER>.mongodb.net/rag_reports?appName=RAG

# OpenAI (used by services/llm.js and the AI test grader)
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
GENERATION_MODEL=gpt-4o-mini


APP_USERS_JSON={"123":"123","tester1":"changeme2","tester2":"changeme3","tester3":"changeme4","tester4":"changeme5","sruthi":"test123"}



PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
# NODE_ENV=production   # hides error details in API responses


# --- EXECUTION LIMITS (defaults shown, safe to omit) -

MAX_CONCURRENT_RUNS=10
MAX_BULK_ROWS=100
TEST_REQUEST_TIMEOUT_MS=30000
SAFE_GET_RETRIES=1
RUN_HISTORY_RETENTION_DAYS=90

