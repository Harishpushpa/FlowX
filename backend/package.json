{
  "name": "rag-api-test-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RAG (MongoDB Atlas Vector Search + Gemini) backend that ingests an API doc, generates REST Assured/TestNG tests from it, runs them, and reports pass/fail/missed.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "ingest": "node scripts/ingest.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "preinstall": "node scripts/check-licenses.js",
    "postinstall": "node scripts/check-licenses.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@google/genai": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^7.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "license-checker": "^25.0.1",
    "supertest": "^7.0.0"
  }
}
